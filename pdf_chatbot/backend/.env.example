# ==============================================================================
# DocIntel AI - Production Environment Configuration
# ==============================================================================

# Core API Settings
APP_NAME="DocIntel AI - PDF Analysis Chatbot"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security & CORS
# In production, set to your specific domain (e.g. https://docintel.yourdomain.com)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
MAX_FILE_SIZE_MB=50

# LLM Provider Configuration
# Get your Google Gemini API Key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Embeddings & Vector Store
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5

# Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUESTS_PER_MINUTE=120
MAX_UPLOADS_PER_MINUTE=20
